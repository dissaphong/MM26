# =============================================================================
# Local development
# =============================================================================
# Use your local Postgres or the Docker container in the README.
DATABASE_URL="postgresql://dissaphong@localhost:5432/mm26?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Email (optional in dev — defaults to console)
# To preview emails locally, run Mailpit:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
MAIL_FROM="MM26 <noreply@mm26.local>"


# =============================================================================
# Production (set these in Vercel → Project → Settings → Environment Variables)
# =============================================================================
# DATABASE_URL — from Neon (pooled connection string with sslmode=require).
# Example:
#   postgresql://USER:PASSWORD@ep-xyz.eu-central-1.aws.neon.tech/mm26?sslmode=require&pgbouncer=true&connect_timeout=15
#
# AUTH_SECRET — same idea as dev, but use a different value. Generate fresh.
#
# AUTH_TRUST_HOST=true
#   Required on hosts where the URL isn't auto-detected. Vercel does detect it,
#   but setting this avoids "UntrustedHost" errors during preview deploys.
#
# Email via Resend SMTP:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx   # your Resend API key
#   MAIL_FROM="MM26 <onboarding@resend.dev>"   # use resend.dev until you verify a real domain
